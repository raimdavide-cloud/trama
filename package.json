{
  "name": "trama",
  "private": true,
  "version": "1.0.0",
  "description": "Trama · dal documento al backlog, con le regole.",
  "type": "module",
  "scripts": {
    "dev": "vercel dev --listen 8888",
    "claude": "node scripts/claude-bridge.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test --project=e2e",
    "sim": "node tests/sim/server.mjs",
    "fixture": "node --env-file=.env tests/fixtures/make-fixture.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "seo": "node scripts/seo/build.mjs",
    "bridge:pack": "node scripts/pack-bridge.mjs",
    "test:visual": "playwright test --project=visual",
    "perf": "node scripts/misura-prestazioni.mjs",
    "i18n:mancanti": "node scripts/i18n/raccogli.mjs",
    "i18n:mancanti-home": "node scripts/i18n/raccogli-home.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  },
  "engines": {
    "node": ">=22"
  }
}
