# Indirizzo pubblico del sito, senza barra finale (in locale: http://localhost:8888)
APP_URL=http://localhost:8888

# Database Postgres (Neon): Dashboard Neon › Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# App OAuth 2.0 (3LO) registrata su https://developer.atlassian.com/console/myapps/
# Callback URL da impostare nell'app: <APP_URL>/api/auth/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Ponte Claude Code (facoltativo): modello e porta. Predefiniti: modello del tuo piano, porta 8790
CLAUDE_MODEL=
BRIDGE_PORT=

# Chiave di cifratura dei token Atlassian salvati nel database (32 byte in base64).
# Generala con: npm run key
TOKEN_KEY=

# Segnalazione privacy giornaliera ad Atlassian (cron di Vercel, /api/cron/privacy-report).
# Segreto che Vercel invia come «Authorization: Bearer …»: senza, la chiamata riceve 401.
CRON_SECRET=
# accountId Atlassian del proprietario dell'app, il cui token firma la segnalazione (vuoto: l'utente più recente)
PRIVACY_REPORTER_ACCOUNT_ID=
